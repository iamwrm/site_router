{
	admin 127.0.0.1:2019
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

https://localhost:8443 {
	bind 127.0.0.1 ::1
	tls internal
	basic_auth {
		admin {$SITE_ADMIN_PASSWORD_HASH}
	}
	root * {$SITE_ROOT:./sites}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control "no-store"
	}
	# Only the Chinese input page needs local dictionary fetches and WebAssembly.
	@chinese path /chinese /chinese/*
	@other not path /chinese /chinese/*
	header @chinese Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	header @other Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	file_server
}

http://localhost:8080 {
	bind 127.0.0.1 ::1
	redir https://localhost:8443{uri} 308
}
